# ============================================
# DB 접속 정보
# ============================================
OPENSQL_HOST=localhost
OPENSQL_PORT=5432
OPENSQL_DB=doc_search
OPENSQL_USER=app_user
OPENSQL_PASSWORD=your_password_here
OPENSQL_POOL_MIN=2
OPENSQL_POOL_MAX=10

# ============================================
# 임베딩 API
# ============================================
EMBEDDING_API_PROVIDER=openai          # openai | cohere | etc.
EMBEDDING_API_KEY=your_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ============================================
# 파이프라인 설정
# ============================================
CHUNK_SIZE=512
CHUNK_OVERLAP=50
EMBEDDING_BATCH_SIZE=100
MAX_RETRIES=3
WORKER_LOCK_TIMEOUT_MINUTES=10
WORKER_POLL_INTERVAL_SECONDS=5
MAX_FILE_SIZE_MB=100

# ============================================
# API 서버
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true                         # 개발 시 true, 운영 시 false

# ============================================
# MCP 서버
# ============================================
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8080

# ============================================
# 로깅
# ============================================
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR

# ============================================
# 파일 저장 경로 (업로드된 원본 파일 보관)
# ============================================
UPLOAD_DIR=./uploads
