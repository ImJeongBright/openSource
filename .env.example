OPENSQL_HOST=localhost
OPENSQL_PORT=5432
OPENSQL_DB=doc_search
OPENSQL_USER=app_user
OPENSQL_PASSWORD=your_password_here
OPENSQL_POOL_MIN=2
OPENSQL_POOL_MAX=10
OPENSQL_COMMAND_TIMEOUT_SECONDS=30

EMBEDDING_API_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:18080
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_KEEP_ALIVE=5m
EMBEDDING_QUERY_INSTRUCTION=Given a Korean enterprise document search query, retrieve relevant passages that answer the query

CHUNK_SIZE=512
CHUNK_OVERLAP=50
EMBEDDING_BATCH_SIZE=100
MAX_RETRIES=3
WORKER_LOCK_TIMEOUT_MINUTES=10
WORKER_POLL_INTERVAL_SECONDS=5
MAX_FILE_SIZE_MB=100
UPLOAD_STREAM_CHUNK_SIZE_BYTES=1048576
SEARCH_DEFAULT_TOP_K=5
SEARCH_MAX_TOP_K=50
SEARCH_MIN_SIMILARITY=0.0
SEARCH_HNSW_EF_SEARCH=100

API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8080

LOG_LEVEL=INFO
UPLOAD_DIR=./uploads
