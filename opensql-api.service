[Unit]
Description=OpenSQL AI Document Search API
Wants=network-online.target
After=network-online.target patroni.service opensql-etcd.service

[Service]
Type=simple
User=rocky
Group=rocky
WorkingDirectory=/home/rocky/opensql-doc-search
Environment="PATH=/home/rocky/opensql-doc-search/.venv/bin:/usr/bin"
Environment="PYTHONDONTWRITEBYTECODE=1"
EnvironmentFile=/etc/opensql-doc-search/app.env
EnvironmentFile=/etc/opensql-doc-search/api.env
ExecStart=/bin/bash -lc 'exec /home/rocky/opensql-doc-search/.venv/bin/python -m uvicorn src.api.routes:app --host 127.0.0.1 --port 8000 --workers 2'
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/rocky/opensql-doc-search/uploads

[Install]
WantedBy=multi-user.target
