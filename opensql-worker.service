[Unit]
Description=OpenSQL AI Document Search Worker Daemon
After=network.target

[Service]
Type=simple
User=app_user
WorkingDirectory=/home/rocky/opensql-doc-search
Environment="PATH=/home/rocky/opensql-doc-search/venv/bin:/usr/bin"
# TODO: 실제 환경 변수 파일 경로로 수정
EnvironmentFile=/home/rocky/opensql-doc-search/.env
ExecStart=/home/rocky/opensql-doc-search/venv/bin/python -m src.worker.daemon
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
